{
  "format": "bedsit.music.plan.v1",
  "notes": "All values are adjustable after listening. Beats are 174 BPM beats. A playable build is 3 x 32 beats: drums (warm-up, not gated) -> bass (gated) -> drums with the recording's own buildup easing in underneath (gated) -> recorded drop -> MIXING (no judging). Layering levels have NOT been auditioned yet.",
  "settings": {
    "threshold": 0.8,
    "recoveryThreshold": 0.6,
    "handoverLeadBeats": 128,
    "maxRecoveryAttempts": 2,
    "fadeOutBeats": 32,
    "customFadeBeats": 2.0,
    "customFadeInBeats": 4.0,
    "recordedFadeBeatsAtBuild": 4.0,
    "buildupFadeInBeats": 8.0,
    "buildupCrossfadeBeats": 4.0,
    "buildupFreeBeats": 4.0,
    "stemMuteRampSeconds": 0.03,
    "stemMuteLevel": 0.15,
    "stemRestoreRampSeconds": 0.08,
    "restoreAfterHits": 2,
    "prepMarginBeats": 8,
    "evalLeadSeconds": 0.2,
    "startDelaySeconds": 3.0,
    "judgePerfectSeconds": 0.045,
    "judgeGoodSeconds": 0.09,
    "customGain": 0.8,
    "customGainUnderRecording": 0.6,
    "recordedGain": 0.9
  },
  "order": ["gatekeeper", "dropdis", "levels"],
  "buildLoops": [
    { "id": "drums",   "gate": false, "recording": false, "charted": ["kick", "snare"], "audible": ["kick", "snare", "backing"] },
    { "id": "bass",    "gate": true,  "recording": false, "charted": ["bass"],          "audible": ["kick", "snare", "bass", "backing"] },
    { "id": "buildup", "gate": true,  "recording": true,  "charted": ["kick", "snare"], "audible": ["kick", "snare", "backing"] }
  ],
  "padMap": {
    "kick": "pad 1 (RhythmWarfare kick cue pad)",
    "snare": "pad 4 (RhythmWarfare snare cue pad)",
    "bass": "pads 1-4 by pitch (RhythmWarfare bass cues)",
    "backing": "not playable (hats accompaniment)"
  },
  "legs": [
    { "id": "L1", "type": "build", "song": "gatekeeper", "anchor": "firstDrop" },
    { "id": "L2", "type": "handover", "from": "gatekeeper", "fromAnchor": "secondDrop", "to": "dropdis", "toAnchor": "firstDrop",
      "fallbackType": "build", "fallbackSong": "gatekeeper", "fallbackAnchor": "secondDrop" },
    { "id": "L3", "type": "build", "song": "dropdis", "anchor": "secondDrop" },
    { "id": "L4", "type": "handover", "from": "dropdis", "fromAnchor": "ending", "to": "levels", "toAnchor": "firstDrop" },
    { "id": "L5", "type": "build", "song": "levels", "anchor": "secondDrop" },
    { "id": "L6", "type": "repeat", "to": "gatekeeper", "toAnchor": "firstDrop", "outgoingCandidates": ["secondDrop", "ending"] }
  ]
}
